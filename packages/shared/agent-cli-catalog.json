[
  {
    "agentId": "codex",
    "binary": "codex",
    "docsUrl": "https://github.com/openai/codex#installing-and-running-codex-cli",
    "npmPackage": "@openai/codex",
    "brewFormula": "codex",
    "brewCask": true,
    "miseTool": "codex",
    "native": {
      "install": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
      "update": "codex update",
      "windowsInstall": "irm https://chatgpt.com/codex/install.ps1 | iex",
      "env": {
        "CODEX_NON_INTERACTIVE": "1"
      },
      "pathMarkers": ["/packages/standalone/", "/programs/openai/codex/"]
    },
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/Programs/OpenAI/Codex/bin"],
      "unix": ["~/.local/bin"]
    },
    "latestVersion": {
      "url": "https://releases.openai.com/codex/channels/latest",
      "jsonField": "tag_name"
    }
  },
  {
    "agentId": "claude",
    "binary": "claude",
    "docsUrl": "https://code.claude.com/docs/en/setup",
    "npmPackage": "@anthropic-ai/claude-code",
    "brewFormula": "claude-code",
    "brewCask": true,
    "native": {
      "install": "curl -fsSL https://claude.ai/install.sh | bash",
      "update": "claude update",
      "windowsInstall": "irm https://claude.ai/install.ps1 | iex",
      "requires": {
        "windows": ["git"]
      }
    },
    "wingetId": "Anthropic.ClaudeCode",
    "miseTool": "claude",
    "installDirs": {
      "windows": ["~/.local/bin"],
      "unix": ["~/.local/bin"]
    },
    "latestVersion": {
      "url": "https://downloads.claude.ai/claude-code-releases/latest"
    }
  },
  {
    "agentId": "cursor",
    "binary": "cursor-agent",
    "docsUrl": "https://cursor.com/docs/cli/installation",
    "native": {
      "install": "curl -fsSL https://cursor.com/install | bash",
      "update": "cursor-agent update",
      "windowsInstall": "irm 'https://cursor.com/install?win32=true' | iex",
      "pathMarkers": ["/cursor-agent/"]
    },
    "miseTool": "cursor-agent",
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/cursor-agent"],
      "unix": ["~/.local/bin"]
    },
    "installNote": "Grok and Cursor both install a command named agent; the one installed last is the one that runs."
  },
  {
    "agentId": "pi",
    "binary": "pi",
    "docsUrl": "https://pi.dev/docs/latest",
    "npmPackage": "@earendil-works/pi-coding-agent",
    "npmFlags": ["--ignore-scripts"],
    "miseTool": "pi",
    "selfUpdate": "pi update self"
  },
  {
    "agentId": "opencode",
    "binary": "opencode",
    "docsUrl": "https://opencode.ai/v2/docs",
    "npmPackage": "@opencode/cli",
    "brewFormula": "opencode",
    "native": {
      "install": "curl -fsSL https://opencode.ai/v2/install | bash",
      "update": "opencode upgrade",
      "windowsInstall": "$gitRoot = Split-Path (Split-Path (Split-Path (git --exec-path))); & (Join-Path $gitRoot 'bin\\bash.exe') -lc 'set -o pipefail; curl -fsSL https://opencode.ai/v2/install | bash'",
      "windowsUpdate": "$gitRoot = Split-Path (Split-Path (Split-Path (git --exec-path))); & (Join-Path $gitRoot 'bin\\bash.exe') -lc 'set -o pipefail; curl -fsSL https://opencode.ai/v2/install | bash'",
      "requires": {
        "windows": ["git"]
      }
    },
    "installDirs": {
      "windows": ["~/.opencode/bin"],
      "unix": ["~/.opencode/bin"]
    }
  },
  {
    "agentId": "gemini",
    "binary": "gemini",
    "docsUrl": "https://github.com/google-gemini/gemini-cli#installation",
    "npmPackage": "@google/gemini-cli",
    "miseTool": "gemini"
  },
  {
    "agentId": "copilot",
    "binary": "copilot",
    "docsUrl": "https://docs.github.com/en/copilot/how-tos/copilot-cli/set-up-copilot-cli/install-copilot-cli",
    "npmPackage": "@github/copilot",
    "brewFormula": "copilot-cli",
    "brewCask": true,
    "wingetId": "GitHub.Copilot",
    "miseTool": "copilot",
    "selfUpdate": "copilot update"
  },
  {
    "agentId": "droid",
    "binary": "droid",
    "docsUrl": "https://docs.factory.ai/droid-cli/cli-reference",
    "npmPackage": "droid",
    "native": {
      "install": "curl -fsSL https://app.factory.ai/cli | sh",
      "update": "droid update"
    },
    "installDirs": {
      "unix": ["~/.local/bin"]
    },
    "updateStopsSessions": true
  },
  {
    "agentId": "grok",
    "binary": "grok",
    "docsUrl": "https://docs.x.ai/build/overview",
    "versionArgs": ["version"],
    "native": {
      "install": "curl -fsSL https://x.ai/cli/install.sh | bash",
      "update": "grok update",
      "windowsInstall": "irm https://x.ai/cli/install.ps1 | iex"
    },
    "miseTool": "grok",
    "npmPackage": "@xai-official/grok",
    "installDirs": {
      "windows": ["~/.grok/bin"],
      "unix": ["~/.grok/bin", "~/.local/bin"]
    },
    "latestVersion": {
      "url": "https://x.ai/cli/stable"
    },
    "installNote": "Grok and Cursor both install a command named agent; the one installed last is the one that runs."
  },
  {
    "agentId": "antigravity",
    "binary": "agy",
    "docsUrl": "https://antigravity.google/docs/cli/install/",
    "native": {
      "install": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
      "windowsInstall": "irm https://antigravity.google/cli/install.ps1 | iex"
    },
    "miseTool": "agy",
    "latestVersion": {
      "url": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json",
      "jsonField": "version"
    },
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/agy/bin"],
      "unix": ["~/.local/bin"]
    }
  },
  {
    "agentId": "amp",
    "binary": "amp",
    "docsUrl": "https://ampcode.com/docs/cli",
    "native": {
      "install": "curl -fsSL https://ampcode.com/install.sh | bash",
      "update": "amp update",
      "windowsInstall": "irm https://ampcode.com/install.ps1 | iex"
    },
    "installDirs": {
      "windows": ["~/.amp/bin"],
      "unix": ["~/.local/bin", "~/.amp/bin"]
    }
  },
  {
    "agentId": "hermes-agent",
    "binary": "hermes",
    "docsUrl": "https://hermes-agent.nousresearch.com/docs/getting-started/installation/",
    "native": {
      "install": "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive",
      "update": "hermes update --yes",
      "windowsInstall": "& ([scriptblock]::Create((irm https://hermes-agent.nousresearch.com/install.ps1))) -NonInteractive",
      "requires": {
        "unix": ["git"]
      }
    },
    "updateCheck": ["update", "--check"]
  },
  {
    "agentId": "rovodev",
    "binary": "acli",
    "docsUrl": "https://developer.atlassian.com/cloud/acli/guides/install/",
    "brewFormula": "atlassian/acli/acli",
    "miseTool": "acli",
    "native": {
      "install": "os=$(uname -s | tr '[:upper:]' '[:lower:]'); case \"$(uname -m)\" in arm64|aarch64) arch=arm64 ;; *) arch=amd64 ;; esac; mkdir -p \"$HOME/.local/bin\" && curl -fsSL -o \"$HOME/.local/bin/acli.download\" \"https://acli.atlassian.com/$os/latest/acli_${os}_$arch/acli\" && chmod 755 \"$HOME/.local/bin/acli.download\" && mv -f \"$HOME/.local/bin/acli.download\" \"$HOME/.local/bin/acli\"",
      "windowsInstall": "$dir = Join-Path $env:LOCALAPPDATA 'Programs\\acli'; New-Item -ItemType Directory -Force -Path $dir | Out-Null; $arch = if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { 'arm64' } else { 'amd64' }; Invoke-WebRequest -UseBasicParsing -Uri \"https://acli.atlassian.com/windows/latest/acli_windows_$arch/acli.exe\" -OutFile (Join-Path $dir 'acli.exe')",
      "plan": "Downloads Atlassian's acli from acli.atlassian.com into your user folder. No password needed.",
      "requires": {
        "unix": ["curl"]
      },
      "pathMarkers": ["/programs/acli/"]
    },
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/Programs/acli"],
      "unix": ["~/.local/bin"]
    }
  },
  {
    "agentId": "codebuddy",
    "binary": "codebuddy",
    "docsUrl": "https://www.codebuddy.ai/docs/cli/quickstart",
    "npmPackage": "@tencent-ai/codebuddy-code"
  },
  {
    "agentId": "qoder",
    "binary": "qodercli",
    "docsUrl": "https://docs.qoder.com/cli/installation",
    "npmPackage": "@qoder-ai/qodercli"
  },
  {
    "agentId": "kiro",
    "binary": "kiro-cli",
    "docsUrl": "https://kiro.dev/downloads/",
    "native": {
      "install": "curl -fsSL https://cli.kiro.dev/install | bash",
      "update": "kiro-cli update --non-interactive",
      "windowsInstall": "irm https://cli.kiro.dev/install.ps1 | iex",
      "requires": {
        "unix": ["unzip"]
      },
      "needsApplicationsFolder": true,
      "pathMarkers": ["/kiro-cli/"]
    },
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/Kiro-Cli"],
      "unix": ["~/.local/bin"]
    }
  },
  {
    "agentId": "omp",
    "binary": "omp",
    "docsUrl": "https://github.com/can1357/oh-my-pi#install",
    "npmPackage": "@oh-my-pi/pi-coding-agent",
    "packageManagers": ["bun"],
    "brewFormula": "can1357/tap/omp",
    "native": {
      "install": "curl -fsSL https://omp.sh/install | sh -s -- --binary",
      "update": "omp update",
      "windowsInstall": "& ([scriptblock]::Create((irm https://omp.sh/install.ps1))) -Binary",
      "pathMarkers": ["/appdata/local/omp/"]
    },
    "minimumBunVersion": "1.3.14",
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/omp"],
      "unix": ["~/.local/bin"]
    }
  },
  {
    "agentId": "kimi",
    "binary": "kimi",
    "docsUrl": "https://github.com/MoonshotAI/kimi-code/tree/main/apps/kimi-code#readme",
    "npmPackage": "@moonshot-ai/kimi-code"
  },
  {
    "agentId": "openclaude",
    "binary": "openclaude",
    "docsUrl": "https://github.com/Gitlawb/openclaude#install",
    "npmPackage": "@gitlawb/openclaude"
  },
  {
    "agentId": "command-code",
    "binary": "commandcode",
    "docsUrl": "https://commandcode.ai/docs",
    "npmPackage": "command-code"
  },
  {
    "agentId": "devin",
    "binary": "devin",
    "docsUrl": "https://cli.devin.ai/",
    "native": {
      "install": "curl -fsSL https://cli.devin.ai/install.sh | bash",
      "windowsInstall": "irm https://static.devin.ai/cli/setup.ps1 | iex"
    },
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/devin/cli"],
      "unix": ["~/.local/bin"]
    }
  },
