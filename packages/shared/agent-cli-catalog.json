    "docsUrl": "https://github.com/kingsword09/zcode-cli",
    "npmPackage": "zcode-app-cli",
    "packageManagers": ["npm"],
    "miseTool": "npm:zcode-app-cli[prerelease=true]"
  },
  {
    "agentId": "freebuff",
    "binary": "freebuff",
    "docsUrl": "https://github.com/CodebuffAI/codebuff/tree/main/freebuff",
    "npmPackage": "freebuff",
    "packageManagers": ["npm"]
  },
  {
    "agentId": "empryo",
    "binary": "empryo",
    "docsUrl": "https://empryo.com/docs/installation",
    "native": {
      "install": "curl -fsSL https://empryo.com/install.sh | bash",
      "windowsInstall": "irm https://empryo.com/install.ps1 | iex",
      "pathMarkers": ["/.empryo/", "/appdata/local/empryo/"]
    },
    "installDirs": {
      "windows": ["%LOCALAPPDATA%/Empryo/bin"],
      "unix": ["~/.empryo/bin"]
    },
    "latestVersion": {
      "url": "https://empryo.com/releases.json",
      "jsonField": "latest"
    }
  },
  {
    "agentId": "dsh",
    "binary": "dsh-tui",
    "docsUrl": "https://github.com/ccch1mneyyy/dsh-TUI#quick-start",
    "npmPackage": "@deepseek-harness-tui/dsh-tui",
    "npmCompanions": [
      { "package": "@deepseek-ai/dsh", "pinNpmLatest": true },
      { "package": "pnpm", "unlessCommand": "pnpm" }
    ],
    "packageManagers": [],
    "miseTool": "npm:@deepseek-harness-tui/dsh-tui",
    "miseThenRun": "dsh-tui update",
    "selfUpdate": "dsh-tui update"
  }
