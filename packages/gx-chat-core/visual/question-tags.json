{
  "radius": 6,
  "paddingX": 5,
  "borderWidth": 1,
  "iconSize": 12,
  "gap": 3,
  "states": {
    "open": {
      "dark": { "text": "#f472b6", "border": "#f472b6", "borderAlpha": 0.4 },
      "light": { "text": "#be185d", "border": "#be185d", "borderAlpha": 0.4 }
    },
    "answered": {
      "dark": { "text": "#a3c9aa", "border": "#8fbf99", "borderAlpha": 0.3 },
      "light": { "text": "#3f6e4a", "border": "#4f8a5c", "borderAlpha": 0.34 }
    },
    "withdrawn": {
      "dark": { "text": "#838383", "border": "#ffffff", "borderAlpha": 0.13 },
      "light": { "text": "#71717a", "border": "#000000", "borderAlpha": 0.16 }
    },
    "skipped": {
      "dark": { "text": "#838383", "border": "#ffffff", "borderAlpha": 0.13 },
      "light": { "text": "#71717a", "border": "#000000", "borderAlpha": 0.16 }
    }
  },
  "hover": {
    "dark": { "color": "#ffffff", "alpha": 0.05 },
    "light": { "color": "#000000", "alpha": 0.04 }
  }
