{
  "_comment": "Token colours for fenced code in chat, taken from the two Shiki themes React highlights with (github-dark-default and github-light-default, named in session-chat-code-highlight.ts). React loads them from Shiki; the native transcript has no Shiki, so the same colours are written here in the Zed highlight-theme shape gpui-component parses (native_chat/markdown_style.rs). Keep the two sides on the same GitHub palette: a reply must not read as two different languages depending on which renderer drew it.",
  "dark": {
    "name": "GitHub Dark Default",
    "appearance": "dark",
    "style": {
      "syntax": {
        "attribute": { "color": "#79c0ff" },
        "boolean": { "color": "#79c0ff" },
        "comment": { "color": "#8b949e" },
        "comment.doc": { "color": "#8b949e" },
        "constant": { "color": "#79c0ff" },
        "constructor": { "color": "#ffa657" },
        "embedded": { "color": "#e6edf3" },
        "emphasis": { "font_style": "italic" },
        "emphasis.strong": { "font_weight": 700 },
        "enum": { "color": "#79c0ff" },
        "function": { "color": "#d2a8ff" },
        "hint": { "color": "#8b949e" },
        "keyword": { "color": "#ff7b72" },
        "label": { "color": "#79c0ff" },
        "link_text": { "color": "#a5d6ff" },
        "link_uri": { "color": "#a5d6ff" },
        "number": { "color": "#79c0ff" },
        "operator": { "color": "#ff7b72" },
        "predictive": { "color": "#6e7681" },
        "preproc": { "color": "#ff7b72" },
        "primary": { "color": "#e6edf3" },
        "property": { "color": "#e6edf3" },
        "punctuation": { "color": "#e6edf3" },
        "punctuation.bracket": { "color": "#e6edf3" },
        "punctuation.delimiter": { "color": "#e6edf3" },
        "punctuation.list_marker": { "color": "#ffa657" },
        "punctuation.special": { "color": "#ff7b72" },
        "string": { "color": "#a5d6ff" },
        "string.escape": { "color": "#ff7b72" },
        "string.regex": { "color": "#a5d6ff" },
        "string.special": { "color": "#a5d6ff" },
        "string.special.symbol": { "color": "#a5d6ff" },
        "tag": { "color": "#7ee787" },
        "tag.doctype": { "color": "#7ee787" },
        "text.code.span": { "color": "#79c0ff" },
        "text.literal": { "color": "#a5d6ff" },
