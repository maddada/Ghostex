+    size_t size;
+    uint32_t image_id;
+    /** Signed viewport coordinates; descendants may be partially off-screen. */
+    int32_t viewport_col;
+    int32_t viewport_row;
+    uint32_t offset_x;
+    uint32_t offset_y;
+    uint32_t dest_width;
+    uint32_t dest_height;
