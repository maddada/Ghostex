+/// C: GhosttyKittyGraphicsVirtualPlacement
+pub const VirtualPlacement = extern struct {
+    size: usize = @sizeOf(VirtualPlacement),
+    image_id: u32 = 0,
+    viewport_col: i32 = 0,
+    viewport_row: i32 = 0,
+    offset_x: u32 = 0,
+    offset_y: u32 = 0,
+    dest_width: u32 = 0,
+    dest_height: u32 = 0,
+    source_x: f64 = 0,
+    source_y: f64 = 0,
+    source_width: f64 = 0,
+    source_height: f64 = 0,
+    z: i32 = -1,
