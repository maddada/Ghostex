# Ghostex's Live Activity push relay (share.ghostex.dev/live-activity/), behind Caddy on the same box.
# Install: /opt/ghostex-push-relay/ghostex-push-relay, the system user ghostex-push-relay, and
# /etc/ghostex-push-relay (root:ghostex-push-relay 0750) for the Apple key (AuthKey.p8) and apns.conf
# (KEY_ID=, TEAM_ID=), each root:ghostex-push-relay 0640. Without them it starts and refuses pushes.
[Unit]
Description=Ghostex Live Activity push relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/ghostex-push-relay/ghostex-push-relay --listen 127.0.0.1:58810 --key /etc/ghostex-push-relay/AuthKey.p8 --config /etc/ghostex-push-relay/apns.conf --behind-proxy
User=ghostex-push-relay
Group=ghostex-push-relay
Restart=always
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/ghostex-push-relay
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=128M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
